sequenceDiagram
    participant C as Content Handler
    participant F as Frontend Admin
    participant AG as API Gateway<br/>(Ingress)
    participant IC as Inventario Service<br/>(Puerto 8001)
    participant DB as PostgreSQL<br/>(inventario schema)

    Note over C,DB: CDU 501: Gestión de Películas
    
    %% Crear
    C->>F: Completa formulario "nueva película"
    F->>AG: POST /inventario/catalog/movies {MovieCreate}
    AG->>IC: Enruta request
    IC->>DB: SELECT fn_movie_create(...)
    DB-->>IC: movie_id generado
    IC-->>AG: {movie_id}
    AG-->>F: Confirmación
    F-->>C: Película creada

    %% Modificar
    C->>F: Edita datos de película existente
    F->>AG: PATCH /inventario/catalog/movies/{id} {MoviePatch}
    AG->>IC: Enruta request
    IC->>DB: SELECT fn_movie_patch($id,$json)
    DB-->>IC: OK
    IC-->>AG: {ok:true}
    AG-->>F: Confirmación
    F-->>C: Película actualizada

    %% Activar/Desactivar
    alt Cambiar estado activo
        C->>F: Cambia flag activo
        F->>AG: PUT /inventario/catalog/movies/{id}/active
        AG->>IC: Enruta request
        IC->>DB: SELECT fn_movie_set_active($id,$flag)
        DB-->>IC: OK
        IC-->>AG: {ok:true}
        AG-->>F: Confirmación
        F-->>C: Estado cambiado
    end

    %% Disponibilidad
    alt Definir ventana disponibilidad
        C->>F: Define fechas from/until
        F->>AG: PUT /inventario/catalog/movies/{id}/availability
        AG->>IC: Enruta request
        IC->>DB: SELECT fn_movie_set_availability($id,$from,$until)
        DB-->>IC: OK
        IC-->>AG: {ok:true}
        AG-->>F: Confirmación
        F-->>C: Disponibilidad actualizada
    end

    %% Gratis/Pago
    alt Cambiar flag gratuito
        C->>F: Marca como gratis/pago
        F->>AG: PUT /inventario/catalog/movies/{id}/is-free
        AG->>IC: Enruta request
        IC->>DB: SELECT fn_movie_set_is_free($id,$flag)
        DB-->>IC: OK
        IC-->>AG: {ok:true}
        AG-->>F: Confirmación
        F-->>C: Flag gratis/pago actualizado
    end
